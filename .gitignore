# ============================================
# NovaGPU Assistant - Git Ignore Config
# ============================================

# Entorno virtual de Python
venv/
.venv/
env/
ENV/

# Variables de entorno y llaves de API (¡IMPORTANTE: NUNCA SUBIR A GITHUB!)
.env
.env.local
.env.*.local

# Base de datos vectorial ChromaDB (se genera dinámicamente)
chroma_db/

# Cache de Python y linters
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Configuración de IDEs, chequeadores de tipos y editores (rutas locales de la máquina)
.vscode/
.idea/
pyrightconfig.json
*.swp
*.swo

# Archivos del sistema operativo
.DS_Store
Thumbs.db
