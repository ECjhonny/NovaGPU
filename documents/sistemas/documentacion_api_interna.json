{
  "api_name": "NovaGPU Internal Telemetry & Fleet Management API",
  "version": "v2.4.0",
  "base_url": "https://api.internal.novagpu.tech/v2",
  "auth_method": "OAuth2 Bearer Token / API Key Header (X-Nova-Key)",
  "endpoints": [
    {
      "path": "/gpus/status",
      "method": "GET",
      "description": "Obtiene la telemetría en tiempo real de los servidores con GPUs Nova Titan X.",
      "parameters": {
        "cluster_id": "string (opcional)",
        "limit": "integer (default: 50)"
      },
      "response_example": {
        "cluster_id": "us-east-oci-01",
        "total_gpus": 128,
        "active_gpus": 126,
        "avg_temperature_celsius": 62.4,
        "avg_vram_usage_percent": 84.1
      }
    },
    {
      "path": "/firmware/update",
      "method": "POST",
      "description": "Despliega una actualización de VBIOS remota a las tarjetas de una granja de cómputo.",
      "body": {
        "gpu_model": "Nova Titan X 64GB",
        "target_bios_version": "v2.0.1-stable",
        "force_flash": false
      }
    },
    {
      "path": "/rag/assistant/query",
      "method": "POST",
      "description": "Endpoint interno del asistente conversacional RAG NovaGPU Assistant.",
      "body": {
        "message": "string (pregunta del usuario)",
        "department": "string (filtro opcional)",
        "session_id": "string (UUID)"
      }
    }
  ]
}
